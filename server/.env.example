# Database Configuration
# When running in Docker, use the service name 'db' as the host.
# Example: postgresql://postgres:password123@db:5432/footy_stats_db?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/database_name?schema=public"

# Server Port
PORT=3001

# API-Football Configuration (RapidAPI)
# Get your key at: https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY="your_rapidapi_key_here"
RAPIDAPI_HOST="api-football-v1.p.rapidapi.com"
